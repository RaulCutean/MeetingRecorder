# Copy to docker/.env and adjust. docker compose and the services fall back to these defaults.

# PostgreSQL (used by all services; each service works in its own schema)
POSTGRES_DB=meeting_recorder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=meetingrecorder
RABBITMQ_PASSWORD=meetingrecorder
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
